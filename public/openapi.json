          "asunto",
          "descripcion"
        ],
        "properties": {
          "tipo": {
            "type": "string",
            "maxLength": 100
          },
          "asunto": {
            "type": "string",
            "maxLength": 150,
            "description": "En compras, el backend establece el asunto según el producto."
          },
          "descripcion": {
            "type": "string"
          },
          "prioridad": {
            "type": "string",
            "enum": [
              "baja",
              "normal",
              "alta",
              "urgente"
            ],
            "default": "normal"
          },
          "product_id": {
            "type": "integer",
            "nullable": true,
            "description": "Al enviarlo, la solicitud se registra como compra."
          }
        }
      },
      "ServiceRequestUpdate": {
        "type": "object",
        "minProperties": 1,
        "properties": {
          "tipo": {
            "type": "string",
            "maxLength": 100
          },
          "asunto": {
            "type": "string",
            "maxLength": 150
          },
          "descripcion": {
            "type": "string"
          },
          "estado": {
            "type": "string",
            "enum": [
