        "properties": {
          "solicitud_servicio_id": {
            "type": "integer"
          },
          "diagnostico": {
            "type": "string"
          },
          "trabajo_realizado": {
            "type": "string"
          },
          "repuestos_utilizados": {
            "type": "string",
            "nullable": true
          },
          "costo_mano_obra": {
            "type": "number",
            "minimum": 0
          },
          "costo_repuestos": {
            "type": "number",
            "minimum": 0
          }
        }
      },
      "ServiceReportCreated": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "reporte": {
