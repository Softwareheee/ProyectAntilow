{
  "openapi": "3.0.3",
  "info": {
    "title": "Antilow API",
    "version": "1.0.0",
    "description": "API de Antilow para autenticación, soporte técnico, catálogo de periféricos, inventario, clientes, administración de usuarios y reportes de servicio. Las rutas administrativas requieren un token Sanctum de un usuario con rol admin.",
    "contact": {
      "name": "Equipo Antilow"
    }
  },
  "servers": [
    {
      "url": "/api",
      "description": "Mismo host desde el que se sirve Laravel"
    },
    {
      "url": "http://localhost:8000/api",
      "description": "Desarrollo local con Docker Compose"
    }
  ],
  "tags": [
    {
      "name": "Autenticación",
      "description": "Registro, inicio y cierre de sesión mediante tokens Sanctum."
    },
    {
      "name": "Productos",
      "description": "Catálogo público y gestión administrativa del inventario."
    },
    {
      "name": "Solicitudes",
      "description": "Solicitudes de soporte y compras vinculadas a clientes."
    },
    {
      "name": "Usuarios",
      "description": "Gestión de cuentas y roles, solo para administradores."
    },
    {
      "name": "Clientes",
      "description": "Directorio de clientes, solo para administradores."
    },
    {
      "name": "Reportes",
      "description": "Informes de servicio y descarga de factura PDF."
    }
  ],
  "security": [],
  "paths": {
    "/register": {
      "post": {
        "tags": [
          "Autenticación"
        ],
        "summary": "Registrar cuenta de cliente",
        "operationId": "register",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              },
              "example": {
                "name": "Ana Pérez",
                "email": "ana@example.com",
                "password": "ClaveSegura123"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Cuenta creada y token emitido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/login": {
      "post": {
        "tags": [
          "Autenticación"
        ],
        "summary": "Iniciar sesión",
        "operationId": "login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              },
              "example": {
                "email": "admin@antilow.test",
                "password": "cambia-esta-clave"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Credenciales válidas; devuelve token y perfil.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/user": {
      "get": {
        "tags": [
          "Autenticación"
        ],
        "summary": "Consultar usuario autenticado",
        "security": [
          {
            "sanctum": []
          }
        ],
        "responses": {
          "200": {
            "description": "Perfil de la sesión actual.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/logout": {
      "post": {
        "tags": [
          "Autenticación"
        ],
        "summary": "Cerrar sesión actual",
        "security": [
          {
            "sanctum": []
          }
        ],
        "responses": {
          "200": {
            "description": "Token revocado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                },
                "example": {
                  "message": "Sesión cerrada"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/productos": {
      "get": {
        "tags": [
          "Productos"
        ],
        "summary": "Consultar catálogo disponible",
        "description": "Público. Visitantes y clientes reciben productos activos. Los cambios de stock requieren rol admin.",
        "responses": {
          "200": {
            "description": "Productos ordenados del más reciente al más antiguo.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Product"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Productos"
        ],
        "summary": "Crear producto",
        "description": "Solo admin. Acepta multipart/form-data. Para imagen local enviar el campo imagen; imagen_url es opcional.",
        "security": [
          {
            "sanctum": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/ProductInput"
              },
              "encoding": {
                "caracteristicas": {
                  "contentType": "application/json"
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Producto creado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Product"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        },
        "x-required-role": "admin"
      }
    },
    "/productos/{producto}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/ProductId"
        }
      ],
      "put": {
        "tags": [
          "Productos"
        ],
        "summary": "Actualizar producto",
        "description": "Solo admin. Actualiza datos del producto usando JSON. Para reemplazar la imagen desde el navegador, utiliza POST con _method=PUT.",
        "security": [
          {
            "sanctum": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProductUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Producto actualizado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Product"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        },
        "x-required-role": "admin"
      },
      "post": {
        "tags": ["Productos"],
        "summary": "Actualizar producto con imagen/form-data",
        "description": "Solo admin. Es el método usado por el frontend: Laravel interpreta _method=PUT y ejecuta la actualización.",
        "parameters": [
          {
            "name": "_method",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "enum": ["PUT"], "default": "PUT" }
          }
        ],
        "security": [{ "sanctum": [] }],
        "x-required-role": "admin",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": { "$ref": "#/components/schemas/ProductUpdate" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Producto actualizado.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Product" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      },
      "patch": {
        "tags": [
          "Productos"
        ],
        "summary": "Actualizar parcialmente un producto",
        "security": [
          {
            "sanctum": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProductUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Producto actualizado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Product"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        },
        "x-required-role": "admin"
      },
      "delete": {
        "tags": [
          "Productos"
        ],
        "summary": "Eliminar producto",
        "security": [
          {
            "sanctum": []
          }
        ],
        "responses": {
          "204": {
            "description": "Producto e imagen local asociada eliminados."
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        },
        "x-required-role": "admin"
      }
    },
    "/solicitudes-servicio": {
      "get": {
        "tags": [
          "Solicitudes"
        ],
        "summary": "Listar solicitudes",
        "description": "Cliente: solo sus solicitudes. Admin: todas, con relaciones de usuario y producto.",
        "security": [
          {
            "sanctum": []
          }
        ],
        "responses": {
          "200": {
            "description": "Solicitudes recientes primero.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ServiceRequest"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "post": {
        "tags": [
          "Solicitudes"
        ],
        "summary": "Crear solicitud de soporte o compra",
        "security": [
          {
            "sanctum": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ServiceRequestInput"
              },
              "examples": {
                "support": {
                  "summary": "Solicitud de soporte",
                  "value": {
                    "tipo": "diagnóstico de equipo",
                    "asunto": "Equipo no enciende",
                    "descripcion": "El portátil dejó de encender hoy.",
                    "prioridad": "alta"
                  }
                },
                "purchase": {
                  "summary": "Solicitud de compra",
                  "value": {
                    "product_id": 12,
                    "tipo": "compra",
                    "asunto": "Solicitud de compra: Teclado",
                    "descripcion": "Me interesa este producto.",
                    "prioridad": "normal"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Solicitud registrada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceRequest"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/solicitudes-servicio/{solicitudServicio}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/ServiceRequestId"
        }
      ],
      "patch": {
        "tags": [
          "Solicitudes"
        ],
        "summary": "Actualizar solicitud",
        "description": "Solo admin. Permite cambiar estado, prioridad, valor y notas.",
        "security": [
          {
            "sanctum": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ServiceRequestUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Solicitud actualizada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceRequest"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        },
        "x-required-role": "admin"
      },
      "delete": {
        "tags": [
          "Solicitudes"
        ],
        "summary": "Eliminar solicitud",
        "description": "Solo admin.",
        "security": [
          {
            "sanctum": []
          }
        ],
        "responses": {
          "204": {
            "description": "Solicitud eliminada."
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        },
        "x-required-role": "admin"
      }
    },
