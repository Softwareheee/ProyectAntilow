              "normal",
              "alta",
              "urgente"
            ]
          },
          "valor": {
            "type": "string",
            "nullable": true
          },
          "notas_admin": {
            "type": "string",
            "nullable": true
          },
          "user": {
            "$ref": "#/components/schemas/User"
          },
          "producto": {
            "$ref": "#/components/schemas/Product"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ServiceRequestInput": {
        "type": "object",
        "required": [
